    "friend_delete_alert_message" : {
      "comment" : "Body of the confirmation alert when deleting a friend.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All associated children will also be permanently deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se eliminarán todos los niños asociados. Esta acción no se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紐づくお子さんの情報もすべて削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相关联的所有孩子信息也将被永久删除。此操作无法撤销。"
          }
        }
      }
    },
